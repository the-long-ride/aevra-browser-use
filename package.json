{
  "name": "@the-long-ride/aevra-browser",
  "version": "1.0.0",
  "description": "Standalone browser-control MCP server built on aevra's extension and CDP drivers.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-long-ride/aevra-browser.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.typecheck.json",
    "lint": "node scripts/loc-lint.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "c8 node scripts/test.mjs",
    "prepack": "npm run build",
    "build:extension": "node scripts/build-extension.mjs",
    "test:package": "node scripts/verify-package-runtime.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "c8": "^12.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.0"
  },
  "bin": {
    "aevra-browser": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "dist/vendor",
    "dist/shared/aevra/packages/agent-integration/src",
    "!dist/test",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "llm.txt"
  ],
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.9.1"
  }
}
